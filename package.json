{
  "name": "full-page-shot",
  "version": "1.3.0",
  "private": true,
  "description": "Extension de Microsoft Edge para capturar paginas web completas (PNG/JPEG).",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run build",
    "update": "git pull && npm install && npm run build",
    "release": "npm run build && node tools/package.mjs",
    "icons": "node tools/make-icons.mjs",
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "package": "node tools/package.mjs",
    "capture": "node tools/agent-capture.mjs",
    "doctor": "node tools/doctor.mjs",
    "agent:launch": "node mcp/launch-chrome.mjs",
    "agent:serve": "node mcp/server.mjs",
    "agent:capture": "node tools/agent-capture.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2"
  }
}
